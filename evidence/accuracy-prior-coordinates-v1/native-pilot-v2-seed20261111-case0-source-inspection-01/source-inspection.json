        {
          "line": 461,
          "text": "        self.register_buffer(\"losses_per_bucket\", losses_per_bucket)"
        },
        {
          "line": 462,
          "text": ""
        },
        {
          "line": 463,
          "text": "    def assert_support(self, *, allow_zero_bucket_left: bool = False) -> None:"
