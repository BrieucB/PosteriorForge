        {
          "line": 256,
          "text": "    def icdf(self, logits: torch.Tensor, left_prob: float) -> torch.Tensor:"
        },
        {
          "line": 257,
          "text": "        \"\"\"Implementation of the quantile function"
        },
        {
          "line": 258,
          "text": "        :param logits: Tensor of any shape, with the last dimension being logits"
        },
        {
          "line": 259,
          "text": "        :param left_prob: float: The probability mass to the left of the result."
        },
        {
          "line": 260,
          "text": "        :return: Position with `left_prob` probability weight to the left."
        },
        {
          "line": 261,
          "text": "        \"\"\""
        },
        {
          "line": 262,
          "text": "        probs = logits.softmax(-1)"
        },
        {
          "line": 263,
          "text": "        cumprobs = torch.cumsum(probs, -1)"
        },
        {
          "line": 264,
          "text": "        idx = ("
        },
        {
          "line": 265,
          "text": "            torch.searchsorted("
        },
        {
          "line": 266,
          "text": "                cumprobs,"
        },
        {
          "line": 267,
          "text": "                left_prob * torch.ones(*cumprobs.shape[:-1], 1, device=logits.device),"
        },
        {
          "line": 268,
          "text": "            )"
        },
        {
          "line": 269,
          "text": "            .squeeze(-1)"
        },
        {
          "line": 270,
          "text": "            .clamp(0, cumprobs.shape[-1] - 1)"
        },
        {
          "line": 271,
          "text": "        )  # this might not do the right for outliers"
        },
        {
          "line": 272,
          "text": "        cumprobs = torch.cat("
        },
        {
          "line": 273,
          "text": "            [torch.zeros(*cumprobs.shape[:-1], 1, device=logits.device), cumprobs],"
        },
        {
          "line": 274,
          "text": "            -1,"
        },
        {
          "line": 275,
          "text": "        )"
        },
        {
          "line": 276,
          "text": ""
        },
        {
          "line": 277,
          "text": "        rest_prob = left_prob - cumprobs.gather(-1, idx[..., None]).squeeze(-1)"
        },
        {
          "line": 278,
          "text": "        left_border = self.borders[idx]"
        },
        {
          "line": 279,
          "text": "        right_border = self.borders[idx + 1]"
        },
        {
          "line": 280,
          "text": "        return left_border + (right_border - left_border) * rest_prob / probs.gather("
        },
        {
          "line": 281,
          "text": "            -1,"
        },
        {
          "line": 282,
          "text": "            idx[..., None],"
        },
        {
          "line": 283,
          "text": "        ).squeeze(-1)"
        }
      ],
